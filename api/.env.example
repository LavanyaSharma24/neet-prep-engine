# Copy to .env for local development (api/main.py loads it via python-dotenv).
# On Cloud Run, set these as env vars / secrets at deploy time instead of a file.

GEMINI_API_KEY=

# Optional overrides:
# Tier 2 cross-check pair (docs/architecture.md §1/§3) — defaults below
# are verified working against the live API as of 2026-09-13. Every
# gemini-2.5-* model is deprecated (404) on a fresh key, and every
# Pro-class model is quota-gated to 0 on the free tier (429, not
# transient) until billing is enabled — see architecture.md decision log
# before changing either default.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_SECONDARY_MODEL=gemini-flash-lite-latest
# ALLOWED_ORIGINS=http://localhost:5173,https://your-web-app-url
# FLAGGED_ITEMS_DB=/tmp/flagged_items.db
